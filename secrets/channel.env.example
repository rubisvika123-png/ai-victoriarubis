# ───────────────────────────────────────────────────────────────────
# channel.env.example — образец настроек агента.
#
# ЧТО ДЕЛАТЬ:
#   1. Сделай копию этого файла и убери «.example» из имени:
#         secrets/channel.env.example  →  secrets/channel.env
#   2. Впиши свои значения в channel.env (подсказки — под каждой строкой).
#   3. Сохрани. Файл channel.env остаётся только у тебя и в репозиторий
#      не попадает.
#
# Здесь настоящих секретов НЕТ — только образец. Свои значения пишешь
# в channel.env, а не в этот файл.
# ───────────────────────────────────────────────────────────────────

# ─── Телеграм-бот ───────────────────────────────────────────────────
# Токен от @BotFather. Вид: 8976066018:AAH...<длинная строка>
TELEGRAM_BOT_TOKEN=сюда_токен_от_BotFather

# Номер бота — это цифры В НАЧАЛЕ токена, до двоеточия.
# Пример: токен 8976066018:AAH... → сюда пиши 8976066018
TELEGRAM_EXPECTED_BOT_ID=сюда_цифры_до_двоеточия

# ─── Кому бот отвечает (только тебе) ────────────────────────────────
# Твой личный Telegram ID — это ЧИСЛО (не телефон и не @username).
# Как узнать: напиши в Telegram боту @userinfobot — он пришлёт твой Id.
# Одно и то же число впиши в обе строки.
TELEGRAM_ALLOWED_USER_IDS=сюда_твой_telegram_id
TELEGRAM_ALLOWED_CHAT_IDS=сюда_твой_telegram_id

# ─── Пути и имя агента ──────────────────────────────────────────────
# Папка с «личностью» агента (там, где лежит CLAUDE.md). По умолчанию —
# корень этого репозитория; менять обычно не нужно.
TELEGRAM_WORKSPACE_ROOT=.

# Короткое имя агента латиницей, без пробелов. Например: assistant
AGENT_ID=assistant

# ─── Служебные (можно не трогать) ───────────────────────────────────
# Рабочие файлы плагина — создаются автоматически.
TELEGRAM_STATE_DIR=./state/telegram
# Внутренний локальный порт (нужен для расширений плагина).
TELEGRAM_WEBHOOK_HOST=127.0.0.1
TELEGRAM_WEBHOOK_PORT=8099

# ─── Память (включим на Уроке 2) ────────────────────────────────────
TELEGRAM_MEMORY_ENABLED=false

# ─── Голосовые сообщения (по желанию) ───────────────────────────────
# Чтобы агент понимал голосовые — получи бесплатный ключ на console.groq.com
# и впиши его ниже. Не нужно — оставь пусто, текст работает и без ключа.
# GROQ_API_KEY=сюда_ключ_groq_если_нужны_голосовые
